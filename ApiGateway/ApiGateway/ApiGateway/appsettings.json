{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "comment-vote-route": {
        "ClusterId": "votes-cluster",
        "Order": 1,
        "Match": { "Path": "/api/posts/{postId}/comments/{commentId}/vote/{**rest}" }
      },
      "post-vote-route": {
        "ClusterId": "votes-cluster",
        "Order": 2,
        "Match": { "Path": "/api/posts/{postId}/vote/{**rest}" }
      },
      "votes-route": {
        "ClusterId": "votes-cluster",
        "Order": 3,
        "Match": { "Path": "/api/votes/{**rest}" }
      },
      "ranking-route": {
        "ClusterId": "ranking-cluster",
        "Order": 4,
        "Match": { "Path": "/api/ranking/{**rest}" }
      },
      "posts-route": {
        "ClusterId": "posts-cluster",
        "Order": 10,
        "Match": { "Path": "/api/posts/{**rest}" }
      },
      "post-singular-route": {
        "ClusterId": "posts-cluster",
        "Order": 10,
        "Match": { "Path": "/api/post/{**rest}" }
      },
      "comments-route": {
        "ClusterId": "posts-cluster",
        "Order": 10,
        "Match": { "Path": "/api/comments/{**rest}" }
      },
      "users-comments-route": {
        "ClusterId": "posts-cluster",
        "Order": 10,
        "Match": { "Path": "/api/users/{**rest}" }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 10,
        "Match": { "Path": "/api/authentication/{**rest}" }
      },
      "authorization-route": {
        "ClusterId": "auth-cluster",
        "Order": 10,
        "Match": { "Path": "/api/authorization/{**rest}" }
      },
      "role-route": {
        "ClusterId": "auth-cluster",
        "Order": 10,
        "Match": { "Path": "/api/role/{**rest}" }
      }
    },
    "Clusters": {
      "votes-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5221/" } } },
      "ranking-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "posts-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5111/" } } },
      "auth-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5298/" } } }
    }
  }
}
